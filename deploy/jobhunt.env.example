# Copy to /etc/jobhunt/jobhunt.env and chmod 600.
# Do not commit real values or paste them into service files.
ANTHROPIC_API_KEY=replace-with-anthropic-key
JOBHUNT_HEADLESS=1
JOBHUNT_POSTING_TIMEOUT_SECONDS=300
JOBHUNT_PLAYWRIGHT_TIMEOUT_MS=30000

# Optional Kith queue sync values belong in /etc/jobhunt/kith.env instead.
# KITH_SUPABASE_URL=https://your-project.supabase.co
# KITH_SUPABASE_SERVICE_ROLE_KEY=replace-me
# KITH_OWNER_ID=replace-me
