#cloud-config
package_update: true
packages:
  - curl
  - jq
  - rsyslog
  - unzip

write_files:
  - path: /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
    owner: root:root
    permissions: '0644'
    content: |
      {
        "agent": {
          "metrics_collection_interval": 60,
          "region": "${aws_region}",
          "run_as_user": "root"
        },
        "metrics": {
          "append_dimensions": {
            "InstanceId": "$${aws:InstanceId}"
          },
          "metrics_collected": {
            "disk": {
              "measurement": ["used_percent"],
              "metrics_collection_interval": 60,
              "resources": ["/"],
              "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs", "overlay", "squashfs"]
            },
            "mem": {
              "measurement": ["mem_used_percent"],
              "metrics_collection_interval": 60
            },
            "swap": {
              "measurement": ["swap_used_percent"],
              "metrics_collection_interval": 60
            }
          }
        },
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/log/syslog",
                  "log_group_name": "${cloudwatch_log_name}",
                  "log_stream_name": "{instance_id}/syslog",
                  "timezone": "UTC"
                },
                {
                  "file_path": "/var/log/cloud-init-output.log",
                  "log_group_name": "${cloudwatch_log_name}",
                  "log_stream_name": "{instance_id}/cloud-init",
                  "timezone": "UTC"
                }
              ]
            }
          }
        }
      }

runcmd:
  - [bash, -lc, "mkdir -p /opt/jobhunt /etc/jobhunt"]
  - [bash, -lc, "arch=$(uname -m); case $arch in x86_64|aarch64) ;; *) echo Unsupported architecture: $arch >&2; exit 1 ;; esac; curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-$arch.zip -o /tmp/awscliv2.zip; rm -rf /tmp/aws; unzip -q /tmp/awscliv2.zip -d /tmp; if command -v aws >/dev/null 2>&1; then /tmp/aws/install --update; else /tmp/aws/install; fi; aws --version"]
  - [bash, -lc, "if command -v snap >/dev/null 2>&1; then snap list amazon-ssm-agent >/dev/null 2>&1 || snap install amazon-ssm-agent --classic; snap start amazon-ssm-agent; fi"]
  - [bash, -lc, "curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/${agent_arch}/latest/amazon-cloudwatch-agent.deb -o /tmp/amazon-cloudwatch-agent.deb"]
  - [bash, -lc, "dpkg -i /tmp/amazon-cloudwatch-agent.deb"]
  - [bash, -lc, "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json"]
  - [bash, -lc, "fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile"]
  - [bash, -lc, "grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab"]
